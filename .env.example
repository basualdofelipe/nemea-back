# App
NODE_ENV=development
PORT=4000

# Branding — neutro por defecto, sobreescribir para rebrandear.
APP_NAME=Hefesto
DEMO_EMAIL=demo@hefesto.com
# ADMIN_EMAIL debe ser una cuenta Google REAL del deployer para poder autenticarse como admin.
# El default 'admin@hefesto.com' es solo un seed valido para DB fresca, no es logueable.
ADMIN_EMAIL=admin@hefesto.com
ADMIN_NAME=Admin

# Database (Docker Compose local)
DATABASE_URL=postgresql://hefesto:hefesto_dev@localhost:5432/hefesto_db

# Database (Test - for E2E tests)
DATABASE_URL_TEST=postgresql://hefesto:hefesto_test@localhost:5433/hefesto_test

# CORS
FRONTEND_URL=http://localhost:3000

# Auth
JWT_SECRET=your-jwt-secret-here-generate-with-crypto
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Demo login — enabled by default so the app works out-of-the-box (clone -> start).
# Exposes POST /api/auth/demo-login, pinned to the seeded demo@hefesto.com account.
DEMO_LOGIN_ENABLED=true
