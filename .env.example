# App
NODE_ENV=development
PORT=4000

# Database (Docker Compose local)
DATABASE_URL=postgresql://nemea:nemea_dev@localhost:5432/nemea_db

# Database (Test - for E2E tests)
DATABASE_URL_TEST=postgresql://nemea:nemea_test@localhost:5433/nemea_test

# CORS
FRONTEND_URL=http://localhost:3000

# Auth
JWT_SECRET=your-jwt-secret-here-generate-with-crypto
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Demo login — enabled by default so the app works out-of-the-box (clone -> start).
# Exposes POST /api/auth/demo-login, pinned to the seeded demo@nemea.app admin account.
DEMO_LOGIN_ENABLED=true
